DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
# nginx is the single entry point; restrict this to your server's IP/domain in production
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=oilwatch
POSTGRES_USER=oilwatch
POSTGRES_PASSWORD=oilwatch

# Django admin superuser, created automatically on first run. Change these
# before deploying anywhere beyond the hackathon demo.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
